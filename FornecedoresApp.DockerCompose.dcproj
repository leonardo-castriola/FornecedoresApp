<Project Sdk="Microsoft.Docker.Sdk">
  <PropertyGroup>
    <DockerTargetOS>Linux</DockerTargetOS>
    <DockerComposeProjectName>fornecedoresapp</DockerComposeProjectName>
    <DockerLaunchAction>LaunchBrowser</DockerLaunchAction>
    <DockerServiceName>api</DockerServiceName>
    <DockerServiceUrl>http://localhost:5214/swagger/index.html</DockerServiceUrl>
    <DependencyAwareStart>true</DependencyAwareStart>
  </PropertyGroup>
  <ItemGroup>
    <None Include="docker-compose.yml" />
  </ItemGroup>
</Project>
